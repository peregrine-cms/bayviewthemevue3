<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:per="http://www.peregrine-cms.com/jcr/cms/1.0"
    jcr:primaryType="per:Page">
    <!--
      Single-source chrome: the template owns header/footer and an empty
      single-column content shell. Pages define ONLY their body (the main
      container's children). At render, Peregrine merges this template's
      jcr:content into the page by node name, so the empty main here fills
      with the page's body, in header -> content -> footer order.
    -->
    <jcr:content
        jcr:primaryType="per:PageContent"
        jcr:title="Standard Page"
        sling:resourceType="bayviewthemevue3/components/page">
        <header
            jcr:primaryType="nt:unstructured"
            sling:resourceType="bayviewthemevue3/components/header"
            variant="badge"
            shrink="true"
            logo="/content/bayviewthemevue3/assets/logo.png"
            logoalt="Taekwondo Bern – White Tiger Crest"
            brandlink="/content/bayviewthemevue3/pages/index">
            <navitems jcr:primaryType="nt:unstructured">
                <i0 jcr:primaryType="nt:unstructured" text="Home" link="/content/bayviewthemevue3/pages/index"/>
                <i1 jcr:primaryType="nt:unstructured" text="Wochenplan" link="/content/bayviewthemevue3/pages/index"/>
            </navitems>
        </header>
        <main jcr:primaryType="nt:unstructured" sling:resourceType="pagerendervue/structure/container"/>
        <footer
            jcr:primaryType="nt:unstructured"
            sling:resourceType="bayviewthemevue3/components/footer"
            brand="TAE KWON DO BERN"
            address="&lt;p&gt;Feldstrasse 32a&lt;br&gt;3073 Gümligen bei Bern&lt;/p&gt;"
            email="info@taekwondobern.ch"
            social="@kim_taekwondo_bern"
            copyright="© 2026 Taekwondo Bern – Alle Rechte vorbehalten."
            image="/content/bayviewthemevue3/assets/team-adults.jpg"
            imagealt="Unser Team"/>
    </jcr:content>
</jcr:root>
