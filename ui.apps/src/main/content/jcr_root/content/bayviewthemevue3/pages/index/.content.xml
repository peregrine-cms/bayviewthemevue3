<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:per="http://www.peregrine-cms.com/jcr/cms/1.0"
    jcr:primaryType="per:Page">
    <!-- Body only. Chrome (header/footer) comes from the standard template
         and merges in at render. -->
    <jcr:content
        jcr:primaryType="per:PageContent"
        jcr:title="Bayview Theme"
        sling:resourceType="bayviewthemevue3/components/page"
        template="/content/bayviewthemevue3/templates/standard"
        templatePath="/content/bayviewthemevue3/templates/standard">
        <main jcr:primaryType="nt:unstructured" sling:resourceType="pagerendervue/structure/container">
            <hero
                jcr:primaryType="nt:unstructured"
                sling:resourceType="bayviewthemevue3/components/herosplit"
                image="/content/bayviewthemevue3/assets/flying-kick.jpg"
                imagealt="Freestyle kick in the dojang"
                logotext="BAYVIEW MARTIAL ARTS"
                kicker="Rooted in the neighbourhood, strong martial arts for every age"
                title="Welcome to the club"
                ctatext="Try a class"
                ctalink="/content/bayviewthemevue3/pages/index"/>
            <legends
                jcr:primaryType="nt:unstructured"
                sling:resourceType="bayviewthemevue3/components/legends"
                title="Home of local legends"
                text="&lt;p&gt;Bayview Martial Arts is more than a club — we are a family. From cubs taking their first steps on the mat to athletes chasing one more title.&lt;/p&gt;"
                image="/content/bayviewthemevue3/assets/poomsae-kid.jpg"
                imagealt="Poomsae stance"/>
            <sponsors
                jcr:primaryType="nt:unstructured"
                sling:resourceType="bayviewthemevue3/components/sponsorband"
                title="Thanks to our supporters"
                image="/content/bayviewthemevue3/assets/dojang-action.jpg"
                imagealt="Training in the dojang">
                <sponsors jcr:primaryType="nt:unstructured">
                    <i0 jcr:primaryType="nt:unstructured" name="Harbour Sports Fund" link="https://example.com/sports-fund"/>
                    <i1 jcr:primaryType="nt:unstructured" name="Bayview Grocers" link="https://example.com/grocers"/>
                    <i2 jcr:primaryType="nt:unstructured" name="Harbour Arena"/>
                    <i3 jcr:primaryType="nt:unstructured" name="National Martial Arts"/>
                </sponsors>
            </sponsors>
            <register
                jcr:primaryType="nt:unstructured"
                sling:resourceType="bayviewthemevue3/components/register"
                title="Sign up"
                text="&lt;p&gt;Train with us — one class, one kick and a large helping of confidence at a time.&lt;/p&gt;"
                namelabel="Full name"
                doblabel="Date of birth"
                emaillabel="Email address"
                leaguelabel="Choose a class"
                levellabel="Level"
                buttontext="Sign up now"
                note="Your details stay confidential. Never send passwords."
                action="mailto:hello@example.com">
                <leagues jcr:primaryType="nt:unstructured">
                    <i0 jcr:primaryType="nt:unstructured" text="Cubs (4+)"/>
                    <i1 jcr:primaryType="nt:unstructured" text="Family"/>
                    <i2 jcr:primaryType="nt:unstructured" text="Youth"/>
                    <i3 jcr:primaryType="nt:unstructured" text="Adults"/>
                </leagues>
                <levels jcr:primaryType="nt:unstructured">
                    <i0 jcr:primaryType="nt:unstructured" text="Advanced"/>
                    <i1 jcr:primaryType="nt:unstructured" text="Intermediate"/>
                    <i2 jcr:primaryType="nt:unstructured" text="Beginner"/>
                </levels>
            </register>
            <leagues
                jcr:primaryType="nt:unstructured"
                sling:resourceType="bayviewthemevue3/components/leagues"
                title="Our classes">
                <items jcr:primaryType="nt:unstructured">
                    <i0 jcr:primaryType="nt:unstructured" image="/content/bayviewthemevue3/assets/team-kids.jpg" imagealt="Cubs class" title="Cubs class" text="Our cubs (ages 4–7) train in small groups, with plenty of games along the way."/>
                    <i1 jcr:primaryType="nt:unstructured" image="/content/bayviewthemevue3/assets/dojang-action.jpg" imagealt="Family class" title="Family class" text="Parents train alongside their children in the same group — every age welcome."/>
                    <i2 jcr:primaryType="nt:unstructured" image="/content/bayviewthemevue3/assets/team-adults.jpg" imagealt="Adults class" title="Adults class" text="From 16 up, everyone trains together — white belt through black belt."/>
                </items>
            </leagues>
            <keydates
                jcr:primaryType="nt:unstructured"
                sling:resourceType="bayviewthemevue3/components/keydates"
                title="Key dates"
                datelabel="Date"
                eventlabel="Event"
                image="/content/bayviewthemevue3/assets/sparring.jpg"
                imagealt="Kyorugi sparring">
                <items jcr:primaryType="nt:unstructured">
                    <i0 jcr:primaryType="nt:unstructured" date="February 22" event="Coach Education, Level B"/>
                    <i1 jcr:primaryType="nt:unstructured" date="February 28" event="National squad training"/>
                    <i2 jcr:primaryType="nt:unstructured" date="March 1" event="Test Match Day"/>
                    <i3 jcr:primaryType="nt:unstructured" date="May 30–31" event="Harbour Trophy (Kyorugi)"/>
                    <i4 jcr:primaryType="nt:unstructured" date="June 20" event="Dan grading"/>
                    <i5 jcr:primaryType="nt:unstructured" date="Every Friday" event="Fight Night at the Harbour Arena"/>
                </items>
            </keydates>
            <gallery
                jcr:primaryType="nt:unstructured"
                sling:resourceType="bayviewthemevue3/components/gallery"
                text="&lt;p&gt;Moments, medals and a lot of laughing.&lt;br&gt;This is more than a sport — it is a community.&lt;/p&gt;">
                <images jcr:primaryType="nt:unstructured">
                    <i0 jcr:primaryType="nt:unstructured" image="/content/bayviewthemevue3/assets/team-kids.jpg" imagealt="Our cubs"/>
                    <i1 jcr:primaryType="nt:unstructured" image="/content/bayviewthemevue3/assets/sparring2.jpg" imagealt="Sparring"/>
                    <i2 jcr:primaryType="nt:unstructured" image="/content/bayviewthemevue3/assets/presidents.jpg" imagealt="Club co-chairs"/>
                    <i3 jcr:primaryType="nt:unstructured" image="/content/bayviewthemevue3/assets/poomsae-comp.jpg" imagealt="Poomsae competition"/>
                    <i4 jcr:primaryType="nt:unstructured" image="/content/bayviewthemevue3/assets/photoshoot.jpg" imagealt="Team photo shoot"/>
                </images>
            </gallery>
            <contact
                jcr:primaryType="nt:unstructured"
                sling:resourceType="bayviewthemevue3/components/contact"
                title="Contact"
                image="/content/bayviewthemevue3/assets/poomsae-kid.jpg"
                imagealt="Poomsae practice"
                namelabel="Name"
                emaillabel="Email address"
                messagelabel="Your message"
                buttontext="Send"
                note="Free trial class — get in touch!"
                action="mailto:hello@example.com"/>
        </main>
    </jcr:content>
</jcr:root>
