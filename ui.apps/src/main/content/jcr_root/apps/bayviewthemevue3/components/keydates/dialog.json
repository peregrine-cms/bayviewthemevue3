{
  "groups": [
    {
      "legend": "others",
      "fields": [
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "title",
          "label": "Heading",
          "model": "title"
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "datelabel",
          "label": "Date Column Label",
          "model": "datelabel"
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "eventlabel",
          "label": "Event Column Label",
          "model": "eventlabel"
        },
        {
          "type": "pathbrowser",
          "browserRoot": "/content/bayviewthemevue3/assets",
          "placeholder": "image",
          "label": "Image",
          "model": "image"
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "imagealt",
          "label": "Image Alt Text",
          "model": "imagealt"
        },
        {
          "type": "collection",
          "multifield": true,
          "fieldLabel": [
            [
              "date"
            ],
            "value"
          ],
          "fields": [
            {
              "type": "input",
              "inputType": "text",
              "placeholder": "date",
              "label": "Date",
              "model": "date"
            },
            {
              "type": "input",
              "inputType": "text",
              "placeholder": "event",
              "label": "Event",
              "model": "event"
            }
          ],
          "placeholder": "items",
          "label": "Rows",
          "model": "items"
        },
        {
          "type": "materialswitch",
          "textOn": "yes",
          "textOff": "no",
          "valueOn": "true",
          "valueOff": "false",
          "placeholder": "swap",
          "label": "Swap Sides (mirror the two columns)",
          "model": "swap"
        },
        {
          "type": "material-select",
          "values": [
            {
              "name": "Always visible",
              "value": "all"
            },
            {
              "name": "Desktop only (821px and up)",
              "value": "desktop"
            },
            {
              "name": "Mobile only (up to 820px)",
              "value": "mobile"
            }
          ],
          "placeholder": "visibility",
          "label": "Visibility",
          "model": "visibility"
        },
        {
          "type": "material-range",
          "placeholder": "focusx",
          "label": "Focus point X (0 = left, 100 = right)",
          "model": "focusx",
          "min": 0,
          "max": 100
        },
        {
          "type": "material-range",
          "placeholder": "focusy",
          "label": "Focus point Y (0 = top, 100 = bottom)",
          "model": "focusy",
          "min": 0,
          "max": 100
        },
        {
          "type": "material-range",
          "placeholder": "zoom",
          "label": "Zoom (100 = normal, up to 200%)",
          "model": "zoom",
          "min": 100,
          "max": 200
        },
        {
          "type": "material-select",
          "values": [
            {
              "name": "Manual entries",
              "value": "manual"
            },
            {
              "name": "Google Calendar (all-day events)",
              "value": "ical"
            }
          ],
          "placeholder": "source",
          "label": "Data source",
          "model": "source"
        },
        {
          "type": "material-range",
          "placeholder": "daysahead",
          "label": "Tage Vorschau (Kalender-Quelle)",
          "model": "daysahead",
          "min": 14,
          "max": 365
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "maxitems",
          "label": "Maximum entries (0 = all)",
          "model": "maxitems"
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "videourl",
          "label": "Vimeo video (URL or ID) — uses the image as its poster",
          "model": "videourl"
        },
        {
          "type": "materialswitch",
          "textOn": "yes",
          "textOff": "no",
          "valueOn": "true",
          "valueOff": "false",
          "placeholder": "videoautoplay",
          "label": "Autoplay video (muted, looped)",
          "model": "videoautoplay"
        }
      ]
    }
  ]
}