{
  "groups": [
    {
      "legend": "others",
      "fields": [
        {
          "type": "pathbrowser",
          "browserRoot": "/content/bayviewthemevue3/assets",
          "placeholder": "image",
          "label": "Image",
          "model": "image"
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "imagealt",
          "label": "Image Alt Text",
          "model": "imagealt"
        },
        {
          "type": "material-select",
          "values": [
            {
              "name": "Auto (natural)",
              "value": "auto"
            },
            {
              "name": "Small (220px cover)",
              "value": "small"
            },
            {
              "name": "Medium (340px cover)",
              "value": "medium"
            },
            {
              "name": "Large (480px cover)",
              "value": "large"
            },
            {
              "name": "Fill parent",
              "value": "fill"
            },
            {
              "name": "Banner (420px cover)",
              "value": "banner"
            },
            {
              "name": "Tile (265px cover)",
              "value": "tile"
            }
          ],
          "placeholder": "height",
          "label": "Height",
          "model": "height"
        },
        {
          "type": "materialswitch",
          "textOn": "yes",
          "textOff": "no",
          "valueOn": "true",
          "valueOff": "false",
          "placeholder": "fullbleed",
          "label": "Full bleed (break out of the container width)",
          "model": "fullbleed"
        },
        {
          "type": "material-select",
          "values": [
            {
              "name": "Always visible",
              "value": "all"
            },
            {
              "name": "Desktop only (821px and up)",
              "value": "desktop"
            },
            {
              "name": "Mobile only (up to 820px)",
              "value": "mobile"
            }
          ],
          "placeholder": "visibility",
          "label": "Visibility",
          "model": "visibility"
        },
        {
          "type": "material-range",
          "placeholder": "focusx",
          "label": "Focus point X (0 = left, 100 = right)",
          "model": "focusx",
          "min": 0,
          "max": 100
        },
        {
          "type": "material-range",
          "placeholder": "focusy",
          "label": "Focus point Y (0 = top, 100 = bottom)",
          "model": "focusy",
          "min": 0,
          "max": 100
        },
        {
          "type": "material-range",
          "placeholder": "zoom",
          "label": "Zoom (100 = normal, up to 200%)",
          "model": "zoom",
          "min": 100,
          "max": 200
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "videourl",
          "label": "Vimeo video (URL or ID) — uses the image as its poster",
          "model": "videourl"
        },
        {
          "type": "materialswitch",
          "textOn": "yes",
          "textOff": "no",
          "valueOn": "true",
          "valueOff": "false",
          "placeholder": "videoautoplay",
          "label": "Autoplay video (muted, looped)",
          "model": "videoautoplay"
        }
      ]
    }
  ]
}