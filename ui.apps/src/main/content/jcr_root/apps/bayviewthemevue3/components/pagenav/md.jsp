<%@ page session="false" contentType="text/plain;charset=UTF-8" pageEncoding="UTF-8"
    import="org.apache.sling.api.resource.ValueMap" %>
<%@ taglib prefix="sling" uri="http://sling.apache.org/taglibs/sling/1.0" %>
<sling:defineObjects/>
<%
  // Generated by percli hatch (mdgen) from model.json — do not edit by hand.
  // Renders the authored properties of a pagenav as Markdown for LLMs.
  ValueMap vm = resource.getValueMap();
  {
    String txt = vm.get("uplabel", "").replaceAll("<[^>]+>", " ").replaceAll("[ \\t]+", " ").trim();
    String lnk = vm.get("uplink", "#");
    if (!txt.isEmpty()) out.write("\n[" + txt + "](" + lnk + ")\n\n");
  }
%>
