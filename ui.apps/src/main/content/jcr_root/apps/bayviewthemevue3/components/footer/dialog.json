{
  "groups": [
    {
      "legend": "others",
      "fields": [
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "brand",
          "label": "Brand (words stack per line)",
          "model": "brand"
        },
        {
          "type": "texteditor",
          "rows": 10,
          "placeholder": "address",
          "label": "Address",
          "model": "address"
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "tel",
          "label": "Telephone",
          "model": "tel"
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "email",
          "label": "E-Mail",
          "model": "email"
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "social",
          "label": "Social Handle",
          "model": "social"
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "copyright",
          "label": "Copyright Line",
          "model": "copyright"
        },
        {
          "type": "pathbrowser",
          "browserRoot": "/content/bayviewthemevue3/assets",
          "placeholder": "image",
          "label": "Photo (right)",
          "model": "image"
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "imagealt",
          "label": "Image Alt Text",
          "model": "imagealt"
        },
        {
          "type": "materialswitch",
          "textOn": "yes",
          "textOff": "no",
          "valueOn": "true",
          "valueOff": "false",
          "placeholder": "swap",
          "label": "Swap Sides (mirror the two columns)",
          "model": "swap"
        },
        {
          "type": "material-select",
          "values": [
            {
              "name": "Always visible",
              "value": "all"
            },
            {
              "name": "Desktop only (821px and up)",
              "value": "desktop"
            },
            {
              "name": "Mobile only (up to 820px)",
              "value": "mobile"
            }
          ],
          "placeholder": "visibility",
          "label": "Visibility",
          "model": "visibility"
        },
        {
          "type": "material-range",
          "placeholder": "focusx",
          "label": "Focus point X (0 = left, 100 = right)",
          "model": "focusx",
          "min": 0,
          "max": 100
        },
        {
          "type": "material-range",
          "placeholder": "focusy",
          "label": "Focus point Y (0 = top, 100 = bottom)",
          "model": "focusy",
          "min": 0,
          "max": 100
        },
        {
          "type": "material-range",
          "placeholder": "zoom",
          "label": "Zoom (100 = normal, up to 200%)",
          "model": "zoom",
          "min": 100,
          "max": 200
        },
        {
          "type": "input",
          "inputType": "text",
          "placeholder": "videourl",
          "label": "Vimeo video (URL or ID) — uses the image as its poster",
          "model": "videourl"
        },
        {
          "type": "materialswitch",
          "textOn": "yes",
          "textOff": "no",
          "valueOn": "true",
          "valueOff": "false",
          "placeholder": "videoautoplay",
          "label": "Autoplay video (muted, looped)",
          "model": "videoautoplay"
        },
        {
          "type": "collection",
          "multifield": true,
          "fieldLabel": [
            [
              "name"
            ],
            "value"
          ],
          "fields": [
            {
              "type": "input",
              "inputType": "text",
              "placeholder": "name",
              "label": "Name",
              "model": "name"
            },
            {
              "type": "input",
              "inputType": "text",
              "placeholder": "link",
              "label": "Link",
              "model": "link"
            }
          ],
          "placeholder": "legallinks",
          "label": "Tiles",
          "model": "legallinks"
        }
      ]
    }
  ]
}